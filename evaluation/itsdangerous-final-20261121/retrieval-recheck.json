            "quote": "  \"merge_commit_sha\": \"105caae4a52c97c1b95d17a0ca956eb56cc7f31b\",\n  \"mergeable\": false,\n  \"mergeable_state\": \"dirty\",\n  \"merged\": false,\n  \"merged_at\": null,",
