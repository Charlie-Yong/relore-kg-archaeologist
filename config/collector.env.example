# Optional for public GitHub samples. Do not commit real tokens.
GITHUB_TOKEN=
# Without this setting, the collector uses .local/collector/index.sqlite3.
# The collector reads environment variables; it does not automatically load this file.
RELORE_DATABASE_URL=postgresql://collector:collector_dev@127.0.0.1:16432/historykg_collector
# For compose.collector.yml; local development only.
COLLECTOR_POSTGRES_PASSWORD=collector_dev
